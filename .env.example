# Optional, and either provider works. Without any key, Crucible falls back to
# the deterministic heuristic evaluator and the whole loop still runs end to end.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which provider to use. Leave empty with one key and it is picked automatically.
# Set it when both keys exist, because a key being present is not a key that
# works: an exhausted credit balance still looks configured from here.
# One of: anthropic, gemini
LLM_PROVIDER=

# Optional. Only if the default Gemini model name has been retired.
GEMINI_MODEL=

# Local default is a file-backed SQLite database. Point this at a Turso URL
# (libsql://...) to run the exact same repositories against hosted SQLite.
# A libsql:// URL needs DATABASE_AUTH_TOKEN as well, from
# `turso db tokens create <database-name>`.
DATABASE_URL=file:crucible.db
DATABASE_AUTH_TOKEN=
