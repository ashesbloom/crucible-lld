# Optional. Without it, Crucible falls back to the deterministic heuristic
# evaluator and the whole loop still works end to end.
ANTHROPIC_API_KEY=

# Local default is a file-backed SQLite database. Point this at a Turso URL
# (libsql://...) to run the exact same repositories against hosted SQLite.
DATABASE_URL=file:crucible.db
DATABASE_AUTH_TOKEN=
