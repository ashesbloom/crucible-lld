# Optional, and either provider works. The first one with a key is used.
# Without any key, Crucible falls back to the deterministic heuristic evaluator
# and the whole loop still runs end to end.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. Only if the default Gemini model name has been retired.
GEMINI_MODEL=

# Local default is a file-backed SQLite database. Point this at a Turso URL
# (libsql://...) to run the exact same repositories against hosted SQLite.
# A libsql:// URL needs DATABASE_AUTH_TOKEN as well, from
# `turso db tokens create <database-name>`.
DATABASE_URL=file:crucible.db
DATABASE_AUTH_TOKEN=
